# Skopiuj do .dev.vars (plik jest w .gitignore).
# DEV_SHOW_CODE=1 pokazuje kod weryfikacyjny na stronie - nigdy nie ustawiaj go na produkcji.
DEV_SHOW_CODE=1
# Adres aplikacji w mailach i linkach (na produkcji ustawiony w wrangler.jsonc).
PUBLIC_ORIGIN=http://localhost:8790
# Opcjonalnie: prawdziwa wysyłka przez SMTP także lokalnie. Bez hasła maile lądują w konsoli.
# SMTP_PASSWORD=...
